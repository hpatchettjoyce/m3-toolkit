# Tabletop Simulator & GAS Credentials
webapp/.clasprc.json

# Local Environment Configs
.env
*.secret
credentials*.json
token*.json

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.tmp
*.log
*.bak

# Claude Code local state (worktrees, machine-local settings).
# Note the trailing /* rather than /: git won't descend into a directory ignored
# by name, so the negation below would never be reached without it.
.claude/*

# ...but the project's shared skills are versioned, so they travel with the repo
# and every fresh session picks them up automatically.
!.claude/skills/
